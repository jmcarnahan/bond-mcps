# Authorization Server (only needed for `make dev-multitenant` / JWT mode)
BOND_MCPS_AS_ENABLED=1
BOND_MCPS_AS_BASE_URL=http://localhost:8001

# Upstream OIDC IdP — "okta" or "cognito"
BOND_MCPS_UPSTREAM_IDP=okta
BOND_MCPS_UPSTREAM_ISSUER=https://<your-org>.okta.com/oauth2/default
BOND_MCPS_UPSTREAM_CLIENT_ID=<your-okta-app-client-id>
BOND_MCPS_UPSTREAM_CLIENT_SECRET=<your-okta-app-client-secret>
BOND_MCPS_UPSTREAM_REDIRECT_URI=http://localhost:8001/oauth/upstream/callback
BOND_MCPS_UPSTREAM_SCOPES=openid email profile

# Token encryption (generate via: cd auth && poetry run bond-mcps generate-key)
BOND_MCPS_ENCRYPTION_KEY=<base64-encoded-32-byte-key>
