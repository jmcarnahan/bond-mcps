MS_CLIENT_ID=<your-azure-app-client-id>
MS_TENANT_ID=consumers
# MS_CLIENT_SECRET=<your-azure-app-client-secret>   # required for confidential clients
# MS_DEFAULT_FROM_ADDRESS=your-alias@outlook.com
# MS_DEBUG=1
# MS_MAIL_ALLOWED_SENDER_DOMAINS=yourcompany.com,yourcompany.onmicrosoft.com   # hide mail from senders outside these domains; unset = off
# MS_SCOPES="Mail.Read Mail.ReadWrite Mail.Send MailboxSettings.Read User.Read Files.Read.All Chat.ReadWrite User.ReadBasic.All"   # scopes a sign-in requests; unset = consented default; widen only after admin consent
