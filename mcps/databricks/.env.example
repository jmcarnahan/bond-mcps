# Databricks workspace connection (always required)
DATABRICKS_HOST=https://<workspace-id>.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/<warehouse-id>

# --- OAuth (recommended) ---
# Register a workspace-level OAuth app and set the redirect URI to:
#   http://localhost:8000/connections/databricks/callback
# Confidential apps set CLIENT_SECRET; public (PKCE-only) apps leave it unset.
DATABRICKS_CLIENT_ID=<your-oauth-app-client-id>
DATABRICKS_CLIENT_SECRET=<your-oauth-app-client-secret-or-leave-blank-for-public-app>

# --- PAT fallback (development only) ---
# Used only when DATABRICKS_CLIENT_ID is NOT set. Databricks free / Community
# Edition cannot register OAuth apps; PAT is the workaround for local dev.
# WARNING: PATs are stored in this .env file in plaintext — never commit .env.
# DATABRICKS_ACCESS_TOKEN=dapi...
