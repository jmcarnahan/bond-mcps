ATLASSIAN_CLIENT_ID=<your-atlassian-oauth-2.0-client-id>
ATLASSIAN_CLIENT_SECRET=<your-atlassian-oauth-2.0-client-secret>

# Optional — auto-discovered from OAuth if unset; pinning avoids picking the wrong site
# ATLASSIAN_CLOUD_ID=<uuid-from-https://your-domain.atlassian.net/_edge/tenant_info>

# Optional — bypass OAuth entirely if you already have a token
# ATLASSIAN_ACCESS_TOKEN=<token>
